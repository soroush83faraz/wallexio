# Names only. Copy to /etc/wallexbot/env (root:wallexbot, mode 0640) or to ./.env for docker compose.
# Shadow mode needs NO secrets: leave every value empty unless you know you need it.
# Do NOT add WALLEX_API_KEY_TRADE or WALLEX_ARM_LIVE here: live trading is not available in this build.

# Optional read-only Wallex key, only for `python -m wallexbot doctor` (never used by the bot loop).
WALLEX_API_KEY_READ=
# Optional, only for `bot --advisor shadow` (log-only AI verdicts). Not used by the default command.
ANTHROPIC_API_KEY=
# Recorder symbols, space or comma separated (empty = the built-in default list).
WALLEXBOT_RECORDER_SYMBOLS=
